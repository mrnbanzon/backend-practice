  "type": "module",
  "main": "./src/server.js",
  "scripts": {
    "test": "npm run test:unit ; npm run test:integration",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules npx jest --selectProjects unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules npx jest --runInBand --selectProjects integration",
